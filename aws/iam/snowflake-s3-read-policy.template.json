{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadSyntheaCsvObjectsOnly",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:GetObjectVersion"
      ],
      "Resource": "arn:aws:s3:::<BUCKET>/<PREFIX>/*"
    },
    {
      "Sid": "ListOnlyTheSyntheaCsvPrefix",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::<BUCKET>",
      "Condition": {
        "StringLike": {
          "s3:prefix": [
            "<PREFIX>/",
            "<PREFIX>/*"
          ]
        }
      }
    },
    {
      "Sid": "ResolveBucketRegion",
      "Effect": "Allow",
      "Action": "s3:GetBucketLocation",
      "Resource": "arn:aws:s3:::<BUCKET>"
    }
  ]
}
